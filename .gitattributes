* text=auto

*.sh  text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.md  text eol=lf

# Git 钩子无扩展名，必须保持 LF，否则在类 Unix 环境下无法执行
scripts/hooks/* text eol=lf

# Golden text fixtures have frozen byte hashes and source offsets.
entry/src/test/fixtures/*.txt text eol=lf

# Exact-byte baseline audits and source contracts must match committed LF bytes.
entry/src/main/ets/knowledge/domain/TextKnowledgeModels.ets text eol=lf
entry/src/main/ets/knowledge/application/TextKnowledgeService.ets text eol=lf
entry/src/main/ets/knowledge/infra/TextFileAdapter.ets text eol=lf
entry/src/main/ets/knowledge/pipeline/TextNormalizer.ets text eol=lf
entry/src/main/ets/knowledge/infra/TextRdbRepository.ets text eol=lf
entry/src/main/ets/knowledge/ui/DocumentParseView.ets text eol=lf
entry/src/test/eval/text-m1-golden.json text eol=lf
entry/src/test/eval/round2-semantic-gold-v1.json text eol=lf
entry/src/main/resources/rawfile/quality/round2-semantic-gold-v1.json text eol=lf
oh-package.json5 text eol=lf
entry/src/main/ets/knowledge/domain/TextKnowledgePorts.ets text eol=lf
