<Window x:Class="LocalAIGateway.Tray.TrayDashboardWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Local AI Gateway"
        Width="740"
        Height="680"
        MinWidth="620"
        MinHeight="500"
        Background="#FFFFFF"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Foreground="#0D0D0D"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F7F5" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#0D0D0D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6E6E6E" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#10A37F" />
        <SolidColorBrush x:Key="AccentTintBrush" Color="#E8F5F0" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        </Style>

        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#0D0D0D" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E5E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="17,8" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#0D0D0D" />
            <Setter Property="BorderBrush" Value="#0D0D0D" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="#EF4146" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E5E5" />
        </Style>

        <Style x:Key="ProfileComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="9">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#F5F5F5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#E8F5F0" />
                                <Setter Property="Foreground" Value="#0A7A5E" />
                                <Setter Property="FontWeight" Value="Medium" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E5E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ProfileComboBoxItemStyle}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12" />

                            <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Placeholder"
                                           Text="选择一个 Profile"
                                           Foreground="#9B9B9B"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <ContentPresenter x:Name="SelectionPresenter"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  VerticalAlignment="Center" />
                                <Path Grid.Column="1"
                                      Width="10"
                                      Height="6"
                                      Margin="14,0,2,0"
                                      Data="M 1 1 L 5 5 L 9 1"
                                      Stroke="#6E6E6E"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="None"
                                      VerticalAlignment="Center" />
                            </Grid>

                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" CornerRadius="12" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=DropDownToggle}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Margin="0,7,0,0"
                                        Padding="6"
                                        Background="#FFFFFF"
                                        BorderBrush="#E5E5E5"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SelectionPresenter" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#10A37F" />
                                <Setter TargetName="ComboChrome" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#10A37F" />
                                <Setter TargetName="ComboChrome" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboChrome" Property="Background" Value="#F5F5F5" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="DashboardRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="DashboardContentScrollViewer"
                      Grid.Row="0"
                      automation:AutomationProperties.AutomationId="DashboardScrollHost"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="VerticalOnly">
            <StackPanel Margin="32,28,32,32">
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="✦"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   Foreground="White" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Local AI Gateway" FontSize="23" FontWeight="Medium" />
                        <TextBlock Text="查看状态、切换 Profile，或控制本地网关" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border x:Name="StatusBadge"
                            Grid.Column="2"
                            Padding="11,6"
                            CornerRadius="99"
                            Background="{StaticResource AccentTintBrush}"
                            BorderBrush="{StaticResource AccentTintBrush}"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                            <TextBlock x:Name="StatusBadgeText" Text="正在读取" FontSize="12" FontWeight="Medium" Foreground="#0A7A5E" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Background="#FAFAFA" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="网关状态" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="DaemonValue" Text="正在读取状态…" FontSize="21" FontWeight="Medium" Margin="0,8,0,0" />
                            <TextBlock x:Name="DaemonDetailValue" Text="控制面状态尚未加载" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="最近更新" Style="{StaticResource EyebrowStyle}" HorizontalAlignment="Right" />
                            <TextBlock x:Name="RefreshedAtValue"
                                       Text="—"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,7,0,0"
                                       HorizontalAlignment="Right" />
                            <TextBlock x:Name="ActivityValue" Text="空闲" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="今天用了" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="TokenValue" Text="0" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="Token" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />
                        <StackPanel Grid.Column="2" Margin="22,0">
                            <TextBlock Text="请求" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="RequestValue" Text="0" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock x:Name="RequestDetailValue" Text="成功 0 · 失败 0" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Column="3" Background="{StaticResource BorderBrush}" />
                        <StackPanel Grid.Column="4" Margin="22,0,0,0">
                            <TextBlock Text="成功率" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="SuccessRateValue" Text="—" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="今天的完成情况" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="选择 Profile" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="运行中切换会先准备新实例，确认可用后再接管请求。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="正在使用" Style="{StaticResource EyebrowStyle}" />
                                <TextBlock x:Name="ActiveProfileValue" Text="—" FontWeight="Medium" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="当前选择" Style="{StaticResource EyebrowStyle}" />
                                <TextBlock x:Name="ConfiguredProfileValue" Text="—" FontWeight="Medium" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ProfileSelector"
                                      VerticalContentAlignment="Center"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource ProfileComboBoxStyle}"
                                      SelectionChanged="OnProfileSelectionChanged"
                                      automation:AutomationProperties.Name="选择 Profile" />
                            <Button x:Name="SwitchButton"
                                    Grid.Column="1"
                                    Content="切换 Profile"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Click="OnSwitchProfileClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Background="#FAFAFA" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="连接状态" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="CircuitSummaryValue" Text="—" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel x:Name="CircuitRows" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorCard"
                        Padding="16"
                        Background="#FFF4F4"
                        BorderBrush="#FAD1D3"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#FDE8E9">
                            <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" Foreground="#EF4146" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                            <TextBlock Text="有一件事需要处理" FontWeight="Medium" Foreground="#B3262B" />
                            <TextBlock x:Name="ErrorValue" TextWrapping="Wrap" Foreground="#B3262B" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="DashboardActionBar"
                Grid.Row="1"
                automation:AutomationProperties.AutomationId="DashboardActionBar"
                Background="#FAFAFA"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="控制网关" FontWeight="Medium" />
                    <TextBlock Text="启动、停止或刷新当前状态" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button x:Name="StartButton" Content="启动" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="OnStartClick" />
                    <Button x:Name="StopButton" Content="停止" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" Click="OnStopClick" />
                    <Button x:Name="RestartButton" Content="重启" Style="{StaticResource BaseButtonStyle}" Margin="0,0,8,0" Click="OnRestartClick" />
                    <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource BaseButtonStyle}" Click="OnRefreshClick" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
